{
  "name": "@daftai/pdsh",
  "description": "Same-window presentation and local capture workbench for DeepSeek Harness; no session isolation.",
  "version": "0.3.0-rc.10",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "client.js.map",
    "cordis.patch.yml",
    "plugin-icon.svg",
    "style-sources.json",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "locale/*.json",
    "components/"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "build": "node --experimental-strip-types build.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm build && pnpm components:check && node --experimental-strip-types --test tests/*.test.ts",
    "bundle": "pnpm build && pnpm components:check && pnpm pack --pack-destination output",
    "release:check": "node --experimental-strip-types check-release.ts",
    "components:check": "node --experimental-strip-types --input-type=module -e \"import { validateComponentSources } from './component-source.ts'; validateComponentSources(process.cwd())\""
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "blobatar": "2.7.0",
    "@daftai/pdsh-titles": "github:daftAI2026/PDSH#8f8a6054201ac1561278fc1a7f9032ae1afd12da&path:/components/titles",
    "@daftai/pdsh-capture": "github:daftAI2026/PDSH#8f8a6054201ac1561278fc1a7f9032ae1afd12da&path:/components/capture",
    "@daftai/pdsh-identity": "github:daftAI2026/PDSH#8f8a6054201ac1561278fc1a7f9032ae1afd12da&path:/components/identity"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daftAI2026/PDSH.git"
  },
  "homepage": "https://github.com/daftAI2026/PDSH#readme",
  "bugs": {
    "url": "https://github.com/daftAI2026/PDSH/issues"
  },
  "license": "MIT",
  "icon": "./plugin-icon.svg"
}
