{
  "name": "@daftai/pdsh",
  "description": "Same-window sidebar title masking and local display identity for DeepSeek Harness; display-only, no session isolation.",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "client.js.map",
    "cordis.patch.yml",
    "plugin-icon.svg",
    "style-sources.json",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "locale/*.json"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "build": "node --experimental-strip-types build.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm build && node --experimental-strip-types --test tests/*.test.ts",
    "bundle": "pnpm build && pnpm pack --pack-destination output",
    "release:check": "node --experimental-strip-types check-release.ts"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "blobatar": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daftAI2026/PDSH.git"
  },
  "homepage": "https://github.com/daftAI2026/PDSH#readme",
  "bugs": {
    "url": "https://github.com/daftAI2026/PDSH/issues"
  },
  "license": "MIT",
  "icon": "./plugin-icon.svg"
}
