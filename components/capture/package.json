{
  "name": "@daftai/pdsh-capture",
  "version": "0.3.0-rc.10",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "client.js.map",
    "plugin-icon.svg",
    "locale/*.json",
    "main.cjs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "icon": "./plugin-icon.svg"
}
