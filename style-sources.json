  "captureInspector": {"implementation": ["src/client/capture/capture-window.css", "src/client/capture/background-picker.css"], "gutterToken": "--dsw-focus-ring-width", "gutterMultiplier": 2, "widthPx": 240, "widthReferenceFile": "src/runtime/capture-window/capture-window.css", "widthDecision": "用户2026-10-03最终选择参考默认右侧240px、左侧剩余宽度；不固定4:1，也不把DSH field-gap/2改成4px。240px是产品布局约束而非缺失Host token的回退。", "referenceFile": "src/runtime/capture-window/background-picker.css", "referenceCommit": "96f9ce30f06a255db572f4cc6092c2f15429fc76", "decision": "参考用4px空间保护4px双层环；DSH space并不保证同样预算，使用Host焦点环宽度两倍保护检查器和网格。拾色图标取Host尺寸与色块减安全边距的较小值，纯色改为与图片/渐变相同的五列圆角方框，局部选择器胜过全局探针尺寸；不去除裁切或缩小整个界面。", "imageSourceGroupingDecision": "按图片来源分组：五预设原网格、系统图片独立组、个人标题行右侧plus。标题使用现有--dsw-font-xxs-12/--dsw-alias-label-tertiary；行高与plus命中区沿用原生Button .md测量的--pdsh-action-size，行间距沿用space=--pdsh-field-gap/2，标题与动作最小gap为2*space即--pdsh-field-gap；文字操作复用已映射前景/禁用态/Host focus-ring，图标复用captureIcons.icons.plus；只改归属，不复制Host选择器或添加数值主题回退。", "selectionRingMultiplier": 0.5, "selectionRingDecision": "用户2026-10-04要求内外选中环更细，两层各取Host焦点宽度的一半；键盘焦点环及安全边距保留原宽。自选颜色入口始终显示pipette，表面/前景采用Host token，不让任意自选色吞掉图标。"},
  "captureBackgroundTabs": {"implementation": ["src/client/capture/background-tabs.tsx", "src/client/capture/background-modes.ts", "src/client/capture/view.ts", "src/client/capture/background-picker.css"], "component": "@deepseek-ai/dsh-client-ui-primitives SegmentedControl", "hostVersion": "0.2.0-rc.2", "hostFiles": ["packages/client/ui-primitives/src/SegmentedControl.tsx", "packages/client/ui-primitives/src/SegmentedControl.module.css"], "installedExport": "app.asar/dsh/node_modules/@deepseek-ai/dsh-client-ui-primitives/lib/index.js", "research": {"shadcn": "https://ui.shadcn.com/docs/components/base/tabs", "shadcnCommit": "295a1f114a138f23b5dfee0e0c6812394dfeb90c", "baseUi": "https://base-ui.com/react/components/tabs", "baseUiCommit": "19511bb171f3b360b006c94cf6d07e53cb446505"}, "decision": "不引入BaseUI/Tailwind依赖。四类即刻应用并记住本次最近素材，实际background是唯一模式真源。沿用Host自动激活/四向箭头/循环/Home-End/禁用跳过，与BaseUI默认手动激活和可聚焦禁用项有意不同，不宣称完整行为复刻。", "panelContract": "四面板始终保留稳定id/aria-labelledby，非当前面板hidden/inert/tabindex=-1；工作台Tab围栏跳过负tabindex与不可见项。 空的无背景面板不添加不可见焦点停靠。", "layout": "240px检查器内四等宽轨道，局部移除Host tab左右16px内边距，不复制CSS Modules hash、主题色或指标几何。键盘走位关闭本控件过渡，指针和减少运动沿用Host。 不重复类别标题；20个渐变全部显示，不设展开/收起控制。", "wallpaperBoundary": "macOS adapter从官方目录关联规则选择最多四项活动系统静图/静帧，不提供Windows系统壁纸获取。图片面板保留五内置预设，系统图片独立组拥有单获取/补缺动作与缓存项，我的图片标题行右侧plus归个人导入；缺provider不展示伪获取操作，已存素材仍可用。"},
  "captureToolbar": {"stateOwner": "src/client/capture/model.ts", "referenceBehavior": "Alma 0.4.160 toolbar: mode、redactSource、style 为三个正交选中状态；只参考交互，不复用主题类。", "consumer": "src/client/capture/view.ts / capture-window.css", "selectedBackground": "--dsw-alias-bg-module-platform", "selectedForeground": "--dsw-alias-label-primary", "hoverBackground": "--dsw-alias-interactive-bg-hover", "pressedBackground": "--dsw-alias-interactive-bg-active", "sourceFile": "packages/client/ui-theme/src/styles/design-platform.css", "decision": "aria-pressed 是唯一选中标记；复用 DSH AppearanceRow 的持久选择底色。rc.2 浅色 layer-2/3 同为 neutral-bluish-00，不可用表面层级充当可见选中。普通 ghost hover/active 仅作用于未选按钮；焦点仍消费 DSH focus ring。不复制 Alma bg-muted/text-foreground 或数值主题色。", "selectedSourceFile": "packages/client/ui-theme/src/AppearanceRow.module.css", "selectedSelector": ".selected"},
  "captureShell": {"implementation": "src/client/capture/capture-window.css", "spacingSource": "--pdsh-field-gap", "spacingSourceFile": "packages/client/ui-primitives/src/settings-form/fields.module.css", "spaceDivisor": 2, "insetMultiplier": 5, "decision": "用户2026-10-04要求外壳上下留白按现有左右对齐；header顶部、workspace左右、footer底部复用同一inset。段落间隔与视口边距不属于外壳inset，保留原值；chrome高度预算补上新增的上下两格。"},
